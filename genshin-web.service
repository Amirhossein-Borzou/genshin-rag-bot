[Unit]
Description=Genshin RAG web chat (borzou.site/genshin/)
After=network.target

[Service]
Type=simple
User=borzou
WorkingDirectory=/home/borzou/genshin-bot/webapp
EnvironmentFile=/home/borzou/genshin-bot/bot.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/borzou/genshin-bot/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8010 --app-dir /home/borzou/genshin-bot/webapp
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
