# Copy to bot.env and fill in — bot.env is gitignored (contains secrets)
GENSHIN_BOT_TOKEN=your_telegram_bot_token_from_botfather
GENSHIN_BOT_LLM_KEY=your_openai_compatible_api_key
GENSHIN_BOT_LLM_BASE=https://api.avalai.ir/v1
GENSHIN_BOT_LLM_MODEL=glm-5.3-flash
GENSHIN_BOT_ALLOWED=your_telegram_user_id
GENSHIN_BOT_RATE_N=15
GENSHIN_BOT_HYBRID=1
